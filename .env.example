# Local development only. Never put real credentials in this file.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# MySQL 8 compatible database. Use the TLS endpoint for a remote provider.
DATABASE_URL=mysql://mafia_user:change_me@127.0.0.1:3306/mafia
DB_SSL=false
# Optional CA certificate in PEM format for providers that use a private CA (for example, Aiven).
DB_SSL_CA=
DB_CONNECTION_LIMIT=5

# Optional realtime updates. Leave the key empty to disable Ably.
REALTIME_PROVIDER=ably
ABLY_API_KEY=

# Optional protection for /api/jobs/reconcile.
CRON_SECRET=
SESSION_TTL_DAYS=14
